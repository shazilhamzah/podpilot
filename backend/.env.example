AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_KEY=your_azure_api_key_here (optional, for local development if not using az login)

MONGO_DB_USER=your_db_username
MONGO_DB_PWD=your_db_password
MONGO_DB_URI=mongodb+srv://your_db_username:your_db_password@your_cluster.mongodb.net/?appName=Cluster0
